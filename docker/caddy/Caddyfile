# =============================================================================
# Khel Drishti gateway (Caddy)
# =============================================================================
# SITE_ADDRESS
#   local : ":80"                      -> plain HTTP (published as localhost:8080)
#   EC2   : "kheldrishti.example.in"   -> automatic HTTPS via Let's Encrypt
#           (DNS A record must point at the instance before first start).
#
# Supabase's Kong gateway is intentionally not used. Kong's only job in the
# upstream stack is routing plus an "apikey" check, and the anon key is public
# by design; authorisation is enforced by JWTs in GoTrue/PostgREST/Storage and
# by Row Level Security in Postgres.
# =============================================================================
{
	admin off
	email {$ACME_EMAIL:admin@localhost}
	servers {
		trusted_proxies static private_ranges
	}
}

# Supabase API routes, prefix stripped exactly like Kong does upstream.
(supabase_api) {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy storage:5000
	}
	handle_path /functions/v1/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy functions:9000 {
			transport http {
				read_timeout 150s
			}
		}
	}
	# The app does not use Realtime; return a clear error rather than the SPA.
	handle /realtime/v1/* {
		respond "Realtime is not enabled on this deployment" 501
	}
}

# ------------------------------------------------------------- public site ----
{$SITE_ADDRESS::80} {
	encode zstd gzip
	import supabase_api

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		# SPA routing: unknown paths fall back to index.html.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# ----------------------------------------- internal service-to-service gateway ----
# Used by edge functions (SUPABASE_URL=http://web:8000). Not published to the host.
:8000 {
	handle /_gateway/health {
		respond "ok" 200
	}
	import supabase_api
}
