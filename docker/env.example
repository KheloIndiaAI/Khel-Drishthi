# =============================================================================
# Khel Drishti — self-hosted configuration
# =============================================================================
# Do not edit this file directly. Generate your real config with:
#   node docker/generate-env.mjs local                 # laptop
#   node docker/generate-env.mjs ec2 --domain kd.example.gov.in
# which writes docker/.env (git-ignored, chmod 600) with fresh secrets.
# Values marked __GENERATED__ are filled in by the generator.
# =============================================================================

# ------------------------------------------------------------------- site ----
# Public URL of the portal. Baked into the web bundle at build time.
SITE_URL=http://localhost:8080
# Caddy site address: ":80" for plain HTTP, or a bare domain for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Let's Encrypt account email (EC2 only).
ACME_EMAIL=admin@localhost

# --------------------------------------------------------------- database ----
# Local / EC2-without-RDS: DB_HOST=db (container from docker/compose.db.yml)
# RDS: DB_HOST=<instance>.<id>.ap-south-1.rds.amazonaws.com, DB_SSLMODE=require
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=prefer
# Admin user used ONLY by the one-shot db-init and migrate jobs.
# On RDS this is the master user; keep the name "postgres".
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=__GENERATED__
# Service login roles created by docker/db/bootstrap.sql.
AUTHENTICATOR_PASSWORD=__GENERATED__
AUTH_ADMIN_PASSWORD=__GENERATED__
STORAGE_ADMIN_PASSWORD=__GENERATED__

# Legacy migrations that cannot run on a fresh database until the live-schema
# baseline exists (scripts/db/README.md, step 2). Clear this once the baseline
# file is in supabase/migrations.
MIGRATE_SKIP=20260816032403,20260816092548

# -------------------------------------------------------------------- JWT ----
# JWT_SECRET signs every token. ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with
# it; regenerate all three together. ANON_KEY is public (shipped to browsers);
# SERVICE_ROLE_KEY bypasses RLS and must never leave the server.
JWT_SECRET=__GENERATED__
ANON_KEY=__GENERATED__
SERVICE_ROLE_KEY=__GENERATED__
JWT_EXPIRY=3600

# ------------------------------------------------------------------- auth ----
DISABLE_SIGNUP=false
PASSWORD_MIN_LENGTH=10
# true only for local dev (skips email confirmation).
MAILER_AUTOCONFIRM=true
# Local: Mailpit. EC2: Amazon SES SMTP (email-smtp.ap-south-1.amazonaws.com:587).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@kheldrishti.local
SMTP_SENDER_NAME=Khel Drishti

# ---------------------------------------------------------------- storage ----
# s3 on AWS (credentials from the EC2 instance role); compose.local.yml forces "file".
STORAGE_BACKEND=s3
AWS_REGION=ap-south-1
# With the file backend this is just the folder name inside the storage volume.
S3_BUCKET=kheldrishti-local
# Only for S3-compatible endpoints; leave empty for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave empty on EC2 (instance role). Only set for non-AWS hosts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- versions ----
# Pinned so every environment runs the same thing. Upgrade deliberately, on
# staging first, and bump GoTrue/Storage together (they own schema migrations).
POSTGRES_VERSION=15.10
GOTRUE_VERSION=v2.170.0
POSTGREST_VERSION=v12.2.8
STORAGE_API_VERSION=v1.19.3
EDGE_RUNTIME_VERSION=v1.67.4
WEB_IMAGE_TAG=latest
